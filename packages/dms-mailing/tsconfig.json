{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "mocha"],
    "lib": ["esnext", "dom"],
    "allowJs": true,
    "resolveJsonModule": true,
    "preserveConstEnums": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "useDefineForClassFields": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["./src/**/*.ts"]
}
