{
  "name": "@antelopejs/dms-mailing",
  "version": "0.2.3",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-mailing.git",
    "directory": "packages/dms-mailing"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "!dist/.tsbuildinfo",
    "frontend-vue",
    "src"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project run -w -p playground",
    "dev:frontend": "cd playground && pnpm frontend:dev",
    "frontend:dev": "cd playground && pnpm frontend:dev",
    "lint": "oxlint && oxfmt --check . && cd frontend-vue && pnpm lint",
    "lint:fix": "oxlint --fix --max-warnings=1000000 && oxfmt . && cd frontend-vue && pnpm lint:fix",
    "format": "oxfmt . && cd frontend-vue && pnpm format",
    "typecheck": "tsc --noEmit",
    "knip": "knip --dependencies",
    "knip:all": "knip",
    "release": "pnpm --filter @antelopejs/interface-dms-mailing build && pnpm --dir frontend-vue install --frozen-lockfile && release-it",
    "prepack": "pnpm run build",
    "test": "pnpm run test:backend && pnpm run test:layer",
    "test:backend": "pnpm run build && ajs module test .",
    "test:layer": "cd frontend-vue && pnpm test",
    "test:unit": "pnpm run build && DMS_MAILING_TEST_DIR=dist/test/unit ajs module test .",
    "test:integration": "pnpm run build && DMS_MAILING_TEST_DIR=dist/test/integration ajs module test ."
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.0.13 <1.0.0",
    "@antelopejs/interface-api-util": ">=0.1.2 <1.0.0",
    "@antelopejs/interface-core": ">=0.1.1 <1.0.0",
    "@antelopejs/interface-data-api": ">=0.1.9 <1.0.0",
    "@antelopejs/interface-database": "0.1.7",
    "@antelopejs/interface-database-decorators": ">=0.1.6 <1.0.0",
    "@antelopejs/interface-dms": ">=0.2.1 <1.0.0",
    "@antelopejs/interface-dms-mailing": ">=0.4.0 <1.0.0",
    "@antelopejs/interface-email": ">=0.0.5 <1.0.0",
    "node-cron": "^4.2.1",
    "zod": "~3.24.2"
  },
  "devDependencies": {
    "@antelopejs/core": ">=1.9.1 <2",
    "@antelopejs/tooling-configs": ">=0.0.6 <1.0.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.7.1",
    "axios": "^1.7.9",
    "chai": "^4.5.0",
    "knip": "^6.34.0",
    "mongodb-memory-server-core": "^11.0.1",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@antelopejs/interface-dms-automation": ">=0.1.0 <1.0.0"
  },
  "antelopeJs": {
    "baseUrl": "dist",
    "implements": [
      "@antelopejs/interface-dms-mailing"
    ],
    "test": "src/test/antelope.test.ts"
  }
}
