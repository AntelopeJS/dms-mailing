{
  "name": "@antelopejs/dms-mailing",
  "version": "0.7.1",
  "description": "E-mail templates for the AntelopeJS DMS: a block editor with drafts and versions, a send log, delivery metrics and a suppression list.",
  "keywords": [
    "antelopejs",
    "dms",
    "dms-module",
    "email",
    "mailing",
    "templates"
  ],
  "homepage": "https://dms.antelopejs.com/docs/modules/mailing",
  "bugs": {
    "url": "https://github.com/AntelopeJS/dms-mailing/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-mailing.git",
    "directory": "packages/dms-mailing"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "!dist/.tsbuildinfo",
    "!dist/test",
    "frontend-vue",
    "skills",
    "src",
    "!src/test"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project dev -w -p playground",
    "dev:frontend": "cd playground && pnpm frontend:dev",
    "frontend:dev": "cd playground && pnpm frontend:dev",
    "typecheck": "tsc --noEmit",
    "knip": "knip --dependencies",
    "knip:all": "knip",
    "release": "pnpm --filter @antelopejs/interface-dms-mailing build && pnpm --dir frontend-vue install --frozen-lockfile && release-it",
    "prepack": "pnpm run build",
    "test": "pnpm run test:backend && pnpm run test:layer",
    "test:backend": "([ -n \"$DMS_PREBUILT\" ] || pnpm run build) && ajs module test .",
    "test:layer": "cd frontend-vue && pnpm test",
    "test:unit": "([ -n \"$DMS_PREBUILT\" ] || pnpm run build) && DMS_MAILING_TEST_DIR=dist/test/unit ajs module test .",
    "test:integration": "([ -n \"$DMS_PREBUILT\" ] || pnpm run build) && DMS_MAILING_TEST_DIR=dist/test/integration ajs module test ."
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.0.15 <1.0.0",
    "@antelopejs/interface-api-util": ">=0.1.3 <1.0.0",
    "@antelopejs/interface-core": ">=0.2.4 <1.0.0",
    "@antelopejs/interface-data-api": ">=0.4.0 <1.0.0",
    "@antelopejs/interface-database": "file:../../.campaign/tgz/antelopejs-interface-database-beb5f5b.tgz",
    "@antelopejs/interface-database-decorators": ">=0.1.10 <1.0.0",
    "@antelopejs/interface-dms": ">=0.9.0 <1.0.0",
    "@antelopejs/interface-dms-mailing": ">=0.9.0 <0.10.0",
    "@antelopejs/interface-email": ">=0.0.6 <1.0.0",
    "node-cron": "^4.2.1",
    "zod": "~3.24.2"
  },
  "devDependencies": {
    "@antelopejs/core": ">=1.17.1 <2",
    "@antelopejs/mongodb": "file:../../.campaign/tgz/antelopejs-mongodb-5df5db5.tgz",
    "@antelopejs/tooling-configs": "^0.2.12",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.7.1",
    "axios": "^1.7.9",
    "chai": "^4.5.0",
    "knip": "^6.34.0",
    "mongodb-memory-server-core": "^11.0.1",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@antelopejs/interface-dms-automation": ">=0.2.1 <1.0.0"
  },
  "antelopeJs": {
    "baseUrl": "dist",
    "implements": [
      "@antelopejs/interface-dms-mailing"
    ],
    "test": "src/test/antelope.test.ts",
    "skills": [
      "./skills"
    ]
  },
  "dmsFrontend": "dist/frontend-module.js"
}
