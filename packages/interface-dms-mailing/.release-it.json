{
  "git": {
    "commitMessage": "chore(release): @antelopejs/interface-dms-mailing v${version}",
    "tagName": "interface-v${version}",
    "requireCommits": true
  },
  "github": {
    "release": true,
    "releaseName": "@antelopejs/interface-dms-mailing v${version}"
  },
  "hooks": {
    "after:bump": [
      "pnpm --dir ../.. run sync",
      "git add -u ../..",
      "git add CHANGELOG.md"
    ]
  },
  "plugins": {
    "release-it-changelogen": {
      "disableVersion": true
    }
  },
  "npm": {
    "skipChecks": true,
    "allowSameVersion": true
  }
}
