{
  "name": "@antelopejs/interface-dms-mailing",
  "version": "0.9.1",
  "description": "AntelopeJS interface for the DMS mailing module: send templates and report e-mail events from any module.",
  "keywords": [
    "antelopejs",
    "dms",
    "email",
    "interface",
    "mailing"
  ],
  "homepage": "https://dms.antelopejs.com/docs/modules/mailing/extending",
  "bugs": {
    "url": "https://github.com/AntelopeJS/dms-mailing/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/dms-mailing.git",
    "directory": "packages/interface-dms-mailing"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "prepack": "pnpm run build",
    "release": "pnpm run build && pnpm --dir ../.. run lint && pnpm --dir ../.. run format:check && release-it",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@antelopejs/interface-core": ">=0.2.4 <1.0.0",
    "@antelopejs/interface-email": ">=0.0.6 <1.0.0"
  },
  "devDependencies": {
    "@antelopejs/interface-api": "file:../../.campaign/tgz/antelopejs-interface-api-f2a99b5.tgz",
    "@antelopejs/interface-api-util": "file:../../.campaign/tgz/antelopejs-interface-api-util-87b092e.tgz",
    "@antelopejs/interface-data-api": "file:../../.campaign/tgz/antelopejs-interface-data-api-26c36e9.tgz",
    "@antelopejs/interface-database": "file:../../.campaign/tgz/antelopejs-interface-database-02e0360.tgz",
    "@antelopejs/interface-database-decorators": "file:../../.campaign/tgz/antelopejs-interface-database-decorators-e79a62b.tgz",
    "@antelopejs/interface-dms": "file:../../.campaign/tgz/antelopejs-interface-dms-e0787e6.tgz",
    "@antelopejs/tooling-configs": ">=0.0.9 <1.0.0",
    "@types/node": "^24.0.0",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "@antelopejs/interface-database": "file:../../.campaign/tgz/antelopejs-interface-database-02e0360.tgz",
      "@antelopejs/interface-api": "file:../../.campaign/tgz/antelopejs-interface-api-f2a99b5.tgz",
      "@antelopejs/interface-api-util": "file:../../.campaign/tgz/antelopejs-interface-api-util-87b092e.tgz",
      "@antelopejs/interface-database-decorators": "file:../../.campaign/tgz/antelopejs-interface-database-decorators-e79a62b.tgz",
      "@antelopejs/interface-data-api": "file:../../.campaign/tgz/antelopejs-interface-data-api-26c36e9.tgz",
      "@antelopejs/interface-dms": "file:../../.campaign/tgz/antelopejs-interface-dms-e0787e6.tgz"
    }
  },
  "antelopeJs": {}
}
