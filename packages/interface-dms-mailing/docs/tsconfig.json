{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "paths": {
      "@antelopejs/interface-dms-mailing": ["../src/index.ts"],
      "@antelopejs/interface-dms-mailing/*": ["../src/*"]
    }
  },
  "include": ["../src/**/*.ts", "./**/*.ts"]
}
