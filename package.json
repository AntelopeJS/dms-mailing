{
  "name": "dms-mailing-workspace",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @antelopejs/dms-mailing build",
    "lint": "oxlint && pnpm --dir packages/dms-mailing/frontend-vue lint && pnpm --dir packages/dms-mailing exec antelopejs-check-interface-ranges",
    "typecheck": "pnpm --dir packages/interface-dms-mailing build && pnpm --dir packages/dms-mailing typecheck",
    "knip": "pnpm --filter @antelopejs/dms-mailing knip",
    "test": "pnpm --dir packages/dms-mailing test:layer",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1; then lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "ratchet": "antelopejs-ratchet",
    "sync": "antelopejs-sync",
    "ratchet:update": "antelopejs-ratchet --update",
    "sync:check": "antelopejs-sync --check",
    "format": "oxfmt . && pnpm --dir packages/dms-mailing/frontend-vue format",
    "format:check": "oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt . && pnpm --dir packages/dms-mailing/frontend-vue lint:fix",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "devDependencies": {
    "@antelopejs/tooling-configs": "^0.2.11",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "packageManager": "pnpm@10.6.5"
}
