{
  "pack": "0.2.17",
  "rules": {
    "antelopejs/no-inherited-key-lookup": 9,
    "anti-slop/no-known-value-widening": 8,
    "anti-slop/no-unknown-parameters": 27,
    "anti-slop/no-unknown-returns": 5,
    "anti-slop/no-unsafe-dictionary-type": 41,
    "anti-slop/require-safety-comment-for-type-assertion": 70,
    "typescript/no-unnecessary-type-parameters": 1,
    "typescript/no-unsafe-argument": 32,
    "typescript/no-unsafe-assignment": 63,
    "typescript/no-unsafe-return": 16,
    "typescript/use-unknown-in-catch-callback-variable": 8
  },
  "oversizeFiles": {}
}
