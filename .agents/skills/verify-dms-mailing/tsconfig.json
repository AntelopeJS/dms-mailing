{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../../..",
    "allowJs": true,
    "checkJs": false,
    "maxNodeModuleJsDepth": 5,
    "types": ["node"],
    "lib": ["esnext", "dom", "dom.iterable"],
    "typeRoots": ["../../../packages/dms-mailing/node_modules/@types"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "composite": false,
    "noEmit": true,
    "incremental": false,
    "experimentalDecorators": true
  },
  "include": ["**/*.mjs", "**/*.ts", "**/*.js"],
  "exclude": ["node_modules", "playground/node_modules", "playground/dist"]
}
