{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../../..",
    "allowJs": true,
    "checkJs": false,
    "maxNodeModuleJsDepth": 5,
    "types": ["node"],
    "lib": ["esnext", "dom", "dom.iterable"],
    "typeRoots": ["../../../packages/dms-mailing/node_modules/@types"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "composite": false,
    "noEmit": true,
    "incremental": false,
    "experimentalDecorators": true,
    "paths": {
      "@antelopejs/interface-dms-mailing": ["../../../packages/interface-dms-mailing/src/index.ts"],
      "@antelopejs/interface-dms/*": ["../../../packages/dms-mailing/node_modules/@antelopejs/interface-dms/dist/*"],
      "*": ["../../../packages/dms-mailing/node_modules/*"]
    }
  },
  "include": ["**/*.mjs", "**/*.ts", "**/*.js"],
  "exclude": ["node_modules", "playground/node_modules", "playground/dist"]
}
